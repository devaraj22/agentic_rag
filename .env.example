# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in your values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────────────────────

# ── Groq Cloud API (Recommended for ultra-fast ~1s inference) ─────────────────
# Get free API key at: https://console.groq.com/
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ── Tavily Web Search (required for WEB_ONLY and HYBRID queries) ─────────────
# Get free API key at: https://app.tavily.com/
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# ── Ollama Local Fallback (optional overrides — defaults shown) ──────────────
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=2048

# ── Performance Modes ────────────────────────────────────────────────────────
FAST_MODE=true
